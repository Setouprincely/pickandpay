# .dockerignore

# --- Git Version Control ---
# The .git directory is often huge and is not needed for the build.
.git
.gitignore
.gitattributes

# --- Build Output & Dependencies ---
# These are generated by Maven/Gradle and should never be in the image.
target/
build/
.mvn/

# --- IDE Specific Files & Directories ---
# For IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# For Eclipse / Spring Tool Suite (STS)
.settings/
.classpath
.project
.apt_generated
.factorypath
.springBeans
.sts4-cache

# For Visual Studio Code
.vscode/

# For NetBeans
/nbproject/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# --- Local Environment & Secrets ---
# CRITICAL: Never copy your local environment secrets into a Docker image.
.env

# --- Documentation ---
# Not needed for the application to run.
HELP.md
README.md

# --- Docker & OS Files ---
# The Dockerfile and compose file are instructions, not application code.
Dockerfile
docker-compose.yml
# Mac and Windows OS files
.DS_Store
Thumbs.db

# --- Log files ---
*.log
parse.py
spring_project_output.txt
test_endpoints