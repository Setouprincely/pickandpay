# This is a template for environment variables.
# - For local development, copy this file to .env and fill in the "Local Development" section.
# - The "Production" section is for documentation purposes and shows what variables must be set in your AWS environment.

# --------------------------------------------------------------------
# -- LOCAL DEVELOPMENT (For running with 'docker-compose up')
# --------------------------------------------------------------------
# Copy these variables to your local .env file and fill them in.

# --- Spring Profile ---
SPRING_PROFILES_ACTIVE=dev

# --- Port Mapping ---
APP_PORT=8080
DB_PORT=5432
ADMINER_PORT=8081

# --- PostgreSQL Database Credentials ---
POSTGRES_DB=doch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<your-local-db-password>

# --- Application Secrets ---
# --- Email Service: Resend ---
RESEND_API_KEY=<your-resend-api-key>

# A long, random string for JWT secret
JWT_SECRET_KEY=<your-super-secret-jwt-key-for-local-dev>

# --- Application URLs ---
# Origins permitted to call the API from a browser (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# DochMarket (E-commerce) Frontend
APP_MARKET_FRONTEND_URL=http://localhost:5173
APP_MARKET_PAYMENT_REDIRECT_URL=http://localhost:5173/payment-status

# DochXender (Logistics) Frontend
APP_XENDER_FRONTEND_URL=http://localhost:5174
APP_XENDER_PAYMENT_REDIRECT_URL=http://localhost:5174/payment-status

# --- Fapshi Payment Gateway ---
FAPSHI_API_USER=<your-fapshi-api-user>
FAPSHI_API_KEY=<your-fapshi-api-key>
FAPSHI_BASE_URL=https://sandbox.fapshi.com

# --- Minio Object Storage ---
# MINIO_HOST=localhost
# MINIO_PORT=9000
MINIO_ENDPOINT=https://s3.us-east-005.backblazeb2.com
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=doch

# --- Geocoding ---
GOOGLE_MAPS_API_KEY=<your-google-api-key>
GEO_PROVIDER=osm

# --------------------------------------------------------------------
# -- PRODUCTION (For AWS ECS, Elastic Beanstalk, etc.)
# --------------------------------------------------------------------
# The following variables MUST be set in your production environment.
# DO NOT add these to your local .env file. This is for documentation.

# --- Production Spring Profile ---
# SPRING_PROFILES_ACTIVE=prod

# --- Production Database (e.g., Amazon RDS) ---
# DB_URL=jdbc:postgresql://your-rds-instance-endpoint.rds.amazonaws.com:5432/doch_prod
# DB_USERNAME=prod_db_user
# DB_PASSWORD=(Set in AWS Secrets Manager)

# --- Production Email Service (e.g., Amazon SES) ---
# MAIL_HOST=email-smtp.us-east-1.amazonaws.com
# MAIL_USERNAME=prod_mail_user
# MAIL_PASSWORD=(Set in AWS Secrets Manager)
# MAIL_PORT=587

# --- Production JWT Secret ---
# JWT_SECRET_KEY=(Set in AWS Secrets Manager or Parameter Store)

# --- Production Fapshi Gateway ---
# FAPSHI_API_USER=<your-LIVE-fapshi-api-user>
# FAPSHI_API_KEY=<your-LIVE-fapshi-api-key>
# FAPSHI_BASE_URL=https://live.fapshi.com


# --- Dev/Staging Testing Flags ---
# Auto-verify new accounts (skip email verification). NEVER true in production.
AUTH_AUTO_VERIFY=false

# --- First super-admin account (created on start-up only if it does not exist) ---
# No default password is compiled in: without BOOTSTRAP_SUPER_ADMIN_PASSWORD no account is created.
BOOTSTRAP_SUPER_ADMIN_EMAIL=superadmin@doch.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=<choose-a-strong-password>

# --- Operational tuning (optional; defaults shown) ---
# FAPSHI_WEBHOOK_SECRET=<secret configured on the Fapshi dashboard>
# AUTH_RATE_LIMIT_PER_MINUTE=20
# ORDER_UNPAID_CANCEL_HOURS=48
# PAYMENT_RECONCILE_INTERVAL_MS=120000
# PAYMENT_EXPIRE_HOURS=24
# DELIVERY_MAX_OTP_ATTEMPTS=5

# --- Swagger / OpenAPI ---
# Public URL of this server so Swagger "Execute" targets the right host.
# Local: http://localhost:8080 | Deployed: http://<server-ip>:8080
SWAGGER_SERVER_URL=http://localhost:8080
